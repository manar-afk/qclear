# QCLEAR Environment Configuration Template
# NOTE: Zero API keys are used. QCLEAR integrates with Vertex AI using Application Default Credentials (ADC).

# Runtime environment
NODE_ENV=development
PORT=8080

# Google Cloud Vertex AI Configuration (ADC)
# Leave GOOGLE_CLOUD_PROJECT empty or unset to automatically run in offline-guidance mode.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
GEMINI_MODEL=gemini-3.5-flash

# Optional Air Quality API Tokens (WAQI is secondary fallback; Open-Meteo requires no token)
WAQI_API_TOKEN=
